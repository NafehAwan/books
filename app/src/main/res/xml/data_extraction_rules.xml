<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer. Only the game's save file (Jetpack DataStore) is backed up: to the
  family's own Google account (cloud backup) and when moving to a new phone (device transfer).
  So after reinstalling, the Garage, coins, bought themes and settings come back.
  Nothing else (for example the ads SDK's files) is included.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/tiny_motors.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/tiny_motors.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
